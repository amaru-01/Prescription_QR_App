rules_version = '2';

// VeriDose reads and writes Firestore only from the server, through the
// Firebase Admin SDK (which bypasses these rules) after verifying the user's
// session. Browsers never talk to Firestore directly, so deny everything:
// even a leaked web API key cannot read or write any document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
