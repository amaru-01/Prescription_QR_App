# ── Firebase Admin (server only — never expose) ───────────────────────────────
# Option 1: Provide Firebase credentials as JSON string (recommended for production)
# FIREBASE_CREDENTIALS='{"type":"service_account","project_id":"YOUR_PROJECT_ID",...}'

# Option 2: Provide path to service account JSON file (for local development)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── Firebase web app (public — used only for sign-in in the browser) ──────────
# Firebase Console → Project settings → General → Your apps → Web app config.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Signed prescriptions, notifications, scheduler ────────────────────────────
# Generate all of these with: npm run generate:keys
# RX_SIGNING_PRIVATE_KEY=            # server only: signs prescription QR codes
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=      # public: lets browsers subscribe to push
# VAPID_PRIVATE_KEY=                 # server only
# VAPID_SUBJECT=mailto:you@example.com
# PUSH_ALLOWED_HOSTS=               # optional extra push hosts, comma-separated (".suffix" matches subdomains)
# CRON_SECRET=                       # bearer token for /api/cron/reminders

# ── Abuse protection ─────────────────────────────────────────────────────────
# Shared rate limiter (Upstash Redis REST). Without it, limits are per server instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Firebase App Check (reCAPTCHA Enterprise site key). Setting the key starts MONITOR mode:
# tokens are checked and failures logged. Set APP_CHECK_ENFORCE=1 to reject bad requests.
# NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# APP_CHECK_ENFORCE=
# Behind your own reverse proxy (not Vercel) that overwrites X-Forwarded-For: set to 1 so
# rate limits see real client IPs. Never set it if clients can reach the app directly.
# TRUST_PROXY=
# Seconds-level cache of user lookups, in milliseconds (default 30000; 0 disables).
# AUTH_CACHE_TTL_MS=

# ── Operations ───────────────────────────────────────────────────────────────
# Secret that salts the IP hashes written to security logs (any long random string).
# LOG_IP_SALT=
# Sign-in lifetime in days, 1-14 (default 5). 2 is a good choice for health data.
# SESSION_MAX_AGE_DAYS=
# Minutes without a successful reminder cron run before /api/health?cron=1 reports it stale
# (default 30; 0 turns the check off).
# CRON_STALE_MINUTES=

# ── Client API base (optional) ────────────────────────────────────────────────
# Only needed when the browser must call an API host other than the Next origin.
# Leave unset to use the same-origin /api route handlers (recommended).
# NEXT_PUBLIC_API_BASE=
